<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<jsp:include page="/WEB-INF/jsp/fragments/header.jsp"><jsp:param name="title" value="Receipt"/><jsp:param name="active" value="sales"/><jsp:param name="breadcrumb" value="Receipt"/></jsp:include>
<c:set var="bill" value="${details.bill}"/>
<div class="page-heading no-print"><div><p class="eyebrow">SALE COMPLETE</p><h1>Receipt #${bill.id}</h1><p class="muted">Transaction saved and inventory updated.</p></div><div class="heading-actions"><a class="button button-quiet" href="${pageContext.request.contextPath}/billing">New sale</a><button class="button button-primary" type="button" onclick="window.print()">Print receipt</button></div></div>
<article class="receipt panel"><div class="receipt-brand"><span class="brand-mark">F</span><div><strong>freshmart</strong><small>Everyday goods, thoughtfully picked.</small></div></div><div class="receipt-meta"><div><span>RECEIPT</span><strong>#${bill.id}</strong></div><div><span>DATE</span><strong><c:out value="${bill.createdAt}"/></strong></div><div><span>CUSTOMER</span><strong><c:out value="${bill.customer}"/></strong></div></div><div class="table-wrap"><table><thead><tr><th>Item</th><th>Qty</th><th>Price</th><th class="align-right">Amount</th></tr></thead><tbody><c:forEach items="${details.items}" var="item"><tr><td><c:out value="${item.productName}"/></td><td>${item.quantity}</td><td>₹<fmt:formatNumber value="${item.unitPrice}" minFractionDigits="2" maxFractionDigits="2"/></td><td class="align-right money">₹<fmt:formatNumber value="${item.lineTotal}" minFractionDigits="2" maxFractionDigits="2"/></td></tr></c:forEach></tbody></table></div><div class="receipt-total"><span>Total paid</span><strong>₹<fmt:formatNumber value="${bill.total}" minFractionDigits="2" maxFractionDigits="2" groupingUsed="true"/></strong></div><p class="receipt-thanks">Thank you for shopping at Fresh Mart.</p></article>
<jsp:include page="/WEB-INF/jsp/fragments/footer.jsp"/>